# Absolute production URL (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://example.kz

# ---- Lead delivery: configure at least ONE channel -------------------------
# Without any channel the forms show "онлайн-приём заявок ещё не подключён"
# and never pretend a submission succeeded.

# Telegram bot (recommended): create a bot with @BotFather, add it to a chat,
# get the chat id (e.g. via https://api.telegram.org/bot<TOKEN>/getUpdates).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Generic JSON webhook: Make, Zapier, n8n, Google Apps Script, CRM, etc.
LEADS_WEBHOOK_URL=
LEADS_WEBHOOK_SECRET=

# E-mail via Resend (https://resend.com)
RESEND_API_KEY=
LEADS_EMAIL_TO=
LEADS_EMAIL_FROM=
